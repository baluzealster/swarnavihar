# Swarnavihar website: environment variables
# Copy to .env.local for local development. In production, set these in
# Vercel → Project → Settings → Environment Variables. Never commit real values.
# Setup guide: docs/lead-management.md

# ── Google Sheets (lead storage) ─────────────────────────────────────────────
# The long id in the sheet URL: docs.google.com/spreadsheets/d/<THIS PART>/edit
GOOGLE_SHEETS_SPREADSHEET_ID=
# From the service account JSON key: "client_email"
GOOGLE_SERVICE_ACCOUNT_EMAIL=swarnavihar-leads@your-project.iam.gserviceaccount.com
# From the JSON key: "private_key". Paste it on ONE line, keeping the \n sequences,
# wrapped in double quotes:
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ── Email notifications: SMTP (used when SMTP_HOST is set) or Resend ────────
# Gmail / Google Workspace: smtp.gmail.com, port 465, your address, and an App Password
# (Google Account → Security → 2-Step Verification → App passwords). Never your normal password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
# tls (port 465) or starttls (port 587). Leave empty to choose from the port.
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=

# Alternative to SMTP: Resend API key (only used if SMTP_HOST is empty)
RESEND_API_KEY=

# Sender. With Gmail this must be SMTP_USER (or an alias added in Gmail). Defaults to SMTP_USER.
LEAD_EMAIL_FROM=
# One or more recipients, comma-separated
LEAD_EMAIL_TO=admissions@example.com

# ── Cloudflare Turnstile (bot protection) ────────────────────────────────────
# Site key is public (sent to the browser); the secret key is server-only.
# For local testing, Cloudflare's test keys always pass:
#   site key 1x00000000000000000000AA   secret 1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Google Analytics 4 ───────────────────────────────────────────────────────
# Measurement ID, e.g. G-XXXXXXXXXX. Leave empty to disable analytics.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# ── Build ────────────────────────────────────────────────────────────────────
# Set to 1 to make `npm run build` fail while placeholder content remains
# (Vercel production builds do this automatically).
STRICT_CONTENT=
# Set to 1 to hide the dashed outlines on placeholder content in development
NEXT_PUBLIC_HIDE_PLACEHOLDERS=
