{
  "name": "swarnavihar-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "prebuild": "tsx scripts/check-placeholders.ts && tsx scripts/check-urls.ts",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "check:content": "tsx scripts/check-placeholders.ts --report",
    "test": "tsx --test tests/*.test.ts",
    "leads:setup-sheet": "tsx scripts/setup-sheet.ts",
    "seo:check-urls": "tsx scripts/check-urls.ts"
  },
  "dependencies": {
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20.9"
  }
}
